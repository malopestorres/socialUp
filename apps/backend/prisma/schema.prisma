generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String
  username       String   @unique
  passwordHash   String
  timeZone       String   @default("America/Sao_Paulo")
  role           String   @default("ADMIN")
  billingDiscountEnabled Boolean @default(false)
  billingDiscountPercent Int     @default(0)
  sessionToken   String?  @unique
  sessionIssuedAt DateTime?
  createdAt      DateTime @default(now())
  jobs           Job[]
  companies      Company[]
  socialConnections SocialConnection[]
  subscription   UserPlanSubscription?
  receivedAvisos Aviso[]  @relation("AvisoRecipient")
  createdAvisos  Aviso[]  @relation("AvisoCreator")
}

model SetupInvite {
  id        String   @id @default(cuid())
  inviteKey String   @unique
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Company {
  id             String           @id @default(cuid())
  name           String
  createdByUserId String?
  createdAt      DateTime         @default(now())
  createdBy      User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  connections    SocialConnection[]
  jobs           Job[]
  logs           AgentLog[]
  legacyAgents   Agent[]
}

model Job {
  id           String   @id @default(cuid())
  companyId     String
  createdByUserId String?
  socialConnectionId String?
  filePath     String
  title        String?
  caption      String?
  firstComment String?
  locationName String?
  whatsappBackgroundColor String?
  whatsappRelinkEnabled Boolean @default(false)
  whatsappRelinkConnectionIds Json?
  whatsappRelinkDispatchedAt DateTime?
  instagramPermalink String?
  publicationType String @default("instagram_reel")
  postStory    Boolean  @default(false)
  postReel     Boolean  @default(false)
  postWhatsapp Boolean  @default(false)
  modoWhatsapp String
  dataPostagem DateTime
  publicationState String @default("PUBLISHED")
  status       String   @default("PENDING")
  tentativas   Int      @default(0)
  criadoEm     DateTime @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  lastError    String?
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User?    @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  socialConnection SocialConnection? @relation(fields: [socialConnectionId], references: [id], onDelete: SetNull)
}

model AgentLog {
  id        String   @id @default(cuid())
  companyId  String
  agentId    String?
  level     String
  errorCode String?
  message   String
  screenshotPath String?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
}

model Agent {
  id                  String     @id @default(cuid())
  name                String
  companyId           String
  token               String     @unique
  activationCode      String?    @unique
  activationStatus    String     @default("PENDING")
  activationIssuedAt  DateTime?
  activationUsedAt    DateTime?
  deviceId            String?
  deviceName          String?
  revokedAt           DateTime?
  createdAt           DateTime   @default(now())
  lastSeenAt          DateTime?
  company             Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  logs                AgentLog[]
}

model SocialConnection {
  id                String   @id @default(cuid())
  companyId          String
  createdByUserId    String?
  platform          String
  displayName       String
  loginIdentifier   String?
  secretCipher      String?
  authStatus        String   @default("AUTH_REQUIRED")
  automationMode    String   @default("VISUAL")
  authLaunchUrl     String?
  lastAuthAt        DateTime?
  lastSeenAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobs              Job[]
}

model Plan {
  id                         String   @id @default(cuid())
  code                       String   @unique
  name                       String
  description                String?
  isActive                   Boolean  @default(true)
  isTrial                    Boolean  @default(false)
  maxProfiles                Int
  maxConnections             Int
  maxMonthlyPublications     Int
  monthlyPriceCents          Int?
  yearlyPriceCents           Int?
  stripeProductId            String?
  stripeMonthlyPriceId       String?
  stripeYearlyPriceId        String?
  stripePixMonthlyPriceId    String?
  stripePixYearlyPriceId     String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  subscriptions              UserPlanSubscription[]
}

model UserPlanSubscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  planId               String?
  status               String   @default("PAYMENT_REQUIRED")
  billingModel         String   @default("NONE")
  cycle                String?
  startsAt             DateTime @default(now())
  endsAt               DateTime?
  trialEndsAt          DateTime?
  blockedReason        String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([status, endsAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Aviso {
  id              String    @id @default(cuid())
  userId          String
  createdByUserId String?
  kind            String    @default("SYSTEM")
  title           String
  message         String
  readAt          DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation("AvisoRecipient", fields: [userId], references: [id], onDelete: Cascade)
  createdBy       User?     @relation("AvisoCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("avisos")
}
