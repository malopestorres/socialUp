generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String
  username       String   @unique
  email          String?  @unique
  passwordHash   String?
  needsPlanSelection Boolean @default(false)
  timeZone       String   @default("America/Sao_Paulo")
  role           String   @default("ADMIN")
  billingDiscountEnabled Boolean @default(false)
  billingDiscountPercent Int     @default(0)
  sessionToken   String?  @unique
  sessionIssuedAt DateTime?
  createdAt      DateTime @default(now())
  jobs           Job[]
  companies      Company[]
  socialConnections SocialConnection[]
  subscription   UserPlanSubscription?
  receivedAvisos Aviso[]  @relation("AvisoRecipient")
  createdAvisos  Aviso[]  @relation("AvisoCreator")
  aiKnowledgeDocuments AiKnowledgeDocument[] @relation("AiKnowledgeDocumentAuthor")
  aiAgentThreads AiAgentThread[]
  aiActionLogs   AiActionLog[]
  aiIncidents    AiIncident[] @relation("AiIncidentUser")
  aiCreatedIncidents AiIncident[] @relation("AiIncidentCreator")
  aiUserAlerts   AiUserAlert[]
  workspaceMemberships CompanyMember[]
  sentWorkspaceInvites CompanyInvite[] @relation("WorkspaceInviteSender")
  acceptedWorkspaceInvites CompanyInvite[] @relation("WorkspaceInviteAcceptor")
  decidedPublicationApprovals PublicationApproval[] @relation("PublicationApprovalDecider")
  publicationApprovalComments PublicationApprovalComment[] @relation("PublicationApprovalCommentAuthor")
  publicationApprovalCommentReactions PublicationApprovalCommentReaction[] @relation("PublicationApprovalCommentReactionAuthor")
  authProviders  UserAuthProvider[]
  passwordResetTokens PasswordResetToken[]
}

model UserAuthProvider {
  id            String   @id @default(cuid())
  userId        String
  provider      String
  providerUserId String
  email         String?
  emailVerified Boolean  @default(false)
  displayName   String?
  avatarUrl     String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([email])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
}

model SetupInvite {
  id        String   @id @default(cuid())
  inviteKey String   @unique
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Company {
  id             String           @id @default(cuid())
  name           String
  color          String?
  createdByUserId String?
  kind           String           @default("CLIENT")
  status         String           @default("ACTIVE")
  createdAt      DateTime         @default(now())
  createdBy      User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  connections    SocialConnection[]
  jobs           Job[]
  logs           AgentLog[]
  legacyAgents   Agent[]
  members        CompanyMember[]
  invites        CompanyInvite[]
  publicationApprovals PublicationApproval[]
}

model CompanyMember {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId, role])
}

model CompanyInvite {
  id               String   @id @default(cuid())
  companyId        String
  inviteKey        String   @unique
  role             String
  invitedByUserId  String
  acceptedByUserId String?
  usedAt           DateTime?
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy        User     @relation("WorkspaceInviteSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy       User?    @relation("WorkspaceInviteAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, usedAt, revokedAt])
}

model Job {
  id           String   @id @default(cuid())
  companyId     String
  createdByUserId String?
  socialConnectionId String?
  filePath     String
  title        String?
  caption      String?
  firstComment String?
  hashtags     Json?
  locationName String?
  whatsappBackgroundColor String?
  whatsappRelinkEnabled Boolean @default(false)
  whatsappRelinkConnectionIds Json?
  whatsappRelinkDispatchedAt DateTime?
  instagramPermalink String?
  publicationType String @default("instagram_reel")
  postStory    Boolean  @default(false)
  postReel     Boolean  @default(false)
  postWhatsapp Boolean  @default(false)
  modoWhatsapp String
  dataPostagem DateTime
  publicationState String @default("PUBLISHED")
  status       String   @default("PENDING")
  tentativas   Int      @default(0)
  criadoEm     DateTime @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  lastError    String?
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User?    @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  socialConnection SocialConnection? @relation(fields: [socialConnectionId], references: [id], onDelete: SetNull)
}

model AgentLog {
  id        String   @id @default(cuid())
  companyId  String
  agentId    String?
  level     String
  errorCode String?
  message   String
  screenshotPath String?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
}

model Agent {
  id                  String     @id @default(cuid())
  name                String
  companyId           String
  token               String     @unique
  activationCode      String?    @unique
  activationStatus    String     @default("PENDING")
  activationIssuedAt  DateTime?
  activationUsedAt    DateTime?
  deviceId            String?
  deviceName          String?
  revokedAt           DateTime?
  createdAt           DateTime   @default(now())
  lastSeenAt          DateTime?
  company             Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  logs                AgentLog[]
}

model SocialConnection {
  id                String   @id @default(cuid())
  companyId          String
  createdByUserId    String?
  platform          String
  provider          String   @default("NATIVE")
  providerAccountId String?
  providerExternalId String?
  providerStatus    String?
  providerMetadata  Json?
  displayName       String
  loginIdentifier   String?
  secretCipher      String?
  authStatus        String   @default("AUTH_REQUIRED")
  automationMode    String   @default("VISUAL")
  agencyCanRefresh  Boolean  @default(false)
  authLaunchUrl     String?
  tokenExpiresAt    DateTime?
  lastAuthAt        DateTime?
  lastSeenAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobs              Job[]

  @@index([provider, providerAccountId])
  @@index([provider, providerExternalId])
}

model Plan {
  id                         String   @id @default(cuid())
  code                       String   @unique
  name                       String
  description                String?
  subtitle                   String?
  highlights                 Json?
  isActive                   Boolean  @default(true)
  isPublic                   Boolean  @default(true)
  isTrial                    Boolean  @default(false)
  maxProfiles                Int
  workspaceLimit             Int      @default(1)
  agencyBonusWorkspaceLimit  Int      @default(0)
  maxConnections             Int
  maxWhatsappConnections     Int?     @default(2)
  maxMonthlyPublications     Int
  supportsWorkspaceInvites   Boolean  @default(false)
  supportsClientApproval     Boolean  @default(false)
  displayOrder               Int      @default(0)
  monthlyPriceCents          Int?
  yearlyPriceCents           Int?
  stripeProductId            String?
  stripeMonthlyPriceId       String?
  stripeYearlyPriceId        String?
  stripePixMonthlyPriceId    String?
  stripePixYearlyPriceId     String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  subscriptions              UserPlanSubscription[]
}

model UserPlanSubscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  planId               String?
  status               String   @default("PAYMENT_REQUIRED")
  billingModel         String   @default("NONE")
  cycle                String?
  startsAt             DateTime @default(now())
  endsAt               DateTime?
  trialEndsAt          DateTime?
  blockedReason        String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([status, endsAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Aviso {
  id              String    @id @default(cuid())
  userId          String
  createdByUserId String?
  broadcastKey    String?
  kind            String    @default("SYSTEM")
  iconKey         String?
  title           String
  message         String
  readAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation("AvisoRecipient", fields: [userId], references: [id], onDelete: Cascade)
  createdBy       User?     @relation("AvisoCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([kind, broadcastKey])
  @@map("avisos")
}

model PublicationApproval {
  id                String   @id @default(cuid())
  companyId         String
  schedulerGroupKey String
  titleSnapshot     String?
  status            String   @default("PENDING")
  decidedByUserId   String?
  decidedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  decidedBy         User?    @relation("PublicationApprovalDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  comments          PublicationApprovalComment[]

  @@unique([companyId, schedulerGroupKey])
  @@index([companyId, status])
}

model PublicationApprovalComment {
  id              String   @id @default(cuid())
  approvalId      String
  userId          String
  parentCommentId String?
  message         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  approval        PublicationApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  user            User     @relation("PublicationApprovalCommentAuthor", fields: [userId], references: [id], onDelete: Cascade)
  parentComment   PublicationApprovalComment?  @relation("PublicationApprovalCommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies         PublicationApprovalComment[] @relation("PublicationApprovalCommentReplies")
  reactions       PublicationApprovalCommentReaction[]

  @@index([approvalId, createdAt])
  @@index([userId, createdAt])
  @@index([parentCommentId])
}

model PublicationApprovalCommentReaction {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  comment   PublicationApprovalComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation("PublicationApprovalCommentReactionAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([commentId, createdAt])
  @@index([userId, createdAt])
}

model AiKnowledgeDocument {
  id              String   @id @default(cuid())
  title           String
  category        String   @default("GENERAL")
  status          String   @default("ACTIVE")
  content         String
  tags            Json?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       User?    @relation("AiKnowledgeDocumentAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  chunks          AiKnowledgeChunk[]

  @@index([status, category])
}

model AiKnowledgeChunk {
  id          String   @id @default(cuid())
  documentId  String
  chunkIndex  Int
  content     String
  contentHash String
  embedding   Json?
  createdAt   DateTime @default(now())
  document    AiKnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model AiAgentThread {
  id            String   @id @default(cuid())
  userId        String
  title         String?
  lastMessageAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      AiAgentMessage[]
  actionLogs    AiActionLog[]

  @@index([userId, updatedAt])
}

model AiAgentMessage {
  id         String   @id @default(cuid())
  threadId   String
  role       String
  content    String
  toolName   String?
  toolPayload Json?
  createdAt  DateTime @default(now())
  thread     AiAgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model AiActionLog {
  id           String   @id @default(cuid())
  userId       String
  threadId     String?
  actionName   String
  status       String
  inputPayload Json?
  outputPayload Json?
  errorMessage String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread       AiAgentThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([threadId, createdAt])
}

model AiIncident {
  id              String   @id @default(cuid())
  userId          String?
  createdByUserId String?
  severity        String   @default("MEDIUM")
  status          String   @default("OPEN")
  source          String   @default("BEE_UP")
  title           String
  summary         String
  fingerprint     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User?    @relation("AiIncidentUser", fields: [userId], references: [id], onDelete: SetNull)
  createdBy       User?    @relation("AiIncidentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  events          AiIncidentEvent[]

  @@index([status, severity, createdAt])
  @@index([userId, createdAt])
}

model AiIncidentEvent {
  id         String   @id @default(cuid())
  incidentId String
  type       String
  message    String
  payload    Json?
  createdAt  DateTime @default(now())
  incident   AiIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

model AiUserAlert {
  id        String   @id @default(cuid())
  userId    String
  kind      String   @default("BEE_UP")
  title     String
  message   String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}
