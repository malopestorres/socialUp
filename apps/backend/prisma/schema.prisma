generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String
  username       String   @unique
  passwordHash   String
  timeZone       String   @default("America/Sao_Paulo")
  role           String   @default("ADMIN")
  billingDiscountEnabled Boolean @default(false)
  billingDiscountPercent Int     @default(0)
  sessionToken   String?  @unique
  sessionIssuedAt DateTime?
  createdAt      DateTime @default(now())
  jobs           Job[]
  companies      Company[]
  socialConnections SocialConnection[]
  subscription   UserPlanSubscription?
  receivedAvisos Aviso[]  @relation("AvisoRecipient")
  createdAvisos  Aviso[]  @relation("AvisoCreator")
  aiKnowledgeDocuments AiKnowledgeDocument[] @relation("AiKnowledgeDocumentAuthor")
  aiAgentThreads AiAgentThread[]
  aiActionLogs   AiActionLog[]
  aiIncidents    AiIncident[] @relation("AiIncidentUser")
  aiCreatedIncidents AiIncident[] @relation("AiIncidentCreator")
  aiUserAlerts   AiUserAlert[]
}

model SetupInvite {
  id        String   @id @default(cuid())
  inviteKey String   @unique
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Company {
  id             String           @id @default(cuid())
  name           String
  createdByUserId String?
  createdAt      DateTime         @default(now())
  createdBy      User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  connections    SocialConnection[]
  jobs           Job[]
  logs           AgentLog[]
  legacyAgents   Agent[]
}

model Job {
  id           String   @id @default(cuid())
  companyId     String
  createdByUserId String?
  socialConnectionId String?
  filePath     String
  title        String?
  caption      String?
  firstComment String?
  locationName String?
  whatsappBackgroundColor String?
  whatsappRelinkEnabled Boolean @default(false)
  whatsappRelinkConnectionIds Json?
  whatsappRelinkDispatchedAt DateTime?
  instagramPermalink String?
  publicationType String @default("instagram_reel")
  postStory    Boolean  @default(false)
  postReel     Boolean  @default(false)
  postWhatsapp Boolean  @default(false)
  modoWhatsapp String
  dataPostagem DateTime
  publicationState String @default("PUBLISHED")
  status       String   @default("PENDING")
  tentativas   Int      @default(0)
  criadoEm     DateTime @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  lastError    String?
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User?    @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  socialConnection SocialConnection? @relation(fields: [socialConnectionId], references: [id], onDelete: SetNull)
}

model AgentLog {
  id        String   @id @default(cuid())
  companyId  String
  agentId    String?
  level     String
  errorCode String?
  message   String
  screenshotPath String?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
}

model Agent {
  id                  String     @id @default(cuid())
  name                String
  companyId           String
  token               String     @unique
  activationCode      String?    @unique
  activationStatus    String     @default("PENDING")
  activationIssuedAt  DateTime?
  activationUsedAt    DateTime?
  deviceId            String?
  deviceName          String?
  revokedAt           DateTime?
  createdAt           DateTime   @default(now())
  lastSeenAt          DateTime?
  company             Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  logs                AgentLog[]
}

model SocialConnection {
  id                String   @id @default(cuid())
  companyId          String
  createdByUserId    String?
  platform          String
  displayName       String
  loginIdentifier   String?
  secretCipher      String?
  authStatus        String   @default("AUTH_REQUIRED")
  automationMode    String   @default("VISUAL")
  authLaunchUrl     String?
  lastAuthAt        DateTime?
  lastSeenAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobs              Job[]
}

model Plan {
  id                         String   @id @default(cuid())
  code                       String   @unique
  name                       String
  description                String?
  isActive                   Boolean  @default(true)
  isTrial                    Boolean  @default(false)
  maxProfiles                Int
  maxConnections             Int
  maxMonthlyPublications     Int
  monthlyPriceCents          Int?
  yearlyPriceCents           Int?
  stripeProductId            String?
  stripeMonthlyPriceId       String?
  stripeYearlyPriceId        String?
  stripePixMonthlyPriceId    String?
  stripePixYearlyPriceId     String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  subscriptions              UserPlanSubscription[]
}

model UserPlanSubscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  planId               String?
  status               String   @default("PAYMENT_REQUIRED")
  billingModel         String   @default("NONE")
  cycle                String?
  startsAt             DateTime @default(now())
  endsAt               DateTime?
  trialEndsAt          DateTime?
  blockedReason        String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([status, endsAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Aviso {
  id              String    @id @default(cuid())
  userId          String
  createdByUserId String?
  kind            String    @default("SYSTEM")
  title           String
  message         String
  readAt          DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation("AvisoRecipient", fields: [userId], references: [id], onDelete: Cascade)
  createdBy       User?     @relation("AvisoCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("avisos")
}

model AiKnowledgeDocument {
  id              String   @id @default(cuid())
  title           String
  category        String   @default("GENERAL")
  status          String   @default("ACTIVE")
  content         String
  tags            Json?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       User?    @relation("AiKnowledgeDocumentAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  chunks          AiKnowledgeChunk[]

  @@index([status, category])
}

model AiKnowledgeChunk {
  id          String   @id @default(cuid())
  documentId  String
  chunkIndex  Int
  content     String
  contentHash String
  embedding   Json?
  createdAt   DateTime @default(now())
  document    AiKnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model AiAgentThread {
  id            String   @id @default(cuid())
  userId        String
  title         String?
  lastMessageAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      AiAgentMessage[]
  actionLogs    AiActionLog[]

  @@index([userId, updatedAt])
}

model AiAgentMessage {
  id         String   @id @default(cuid())
  threadId   String
  role       String
  content    String
  toolName   String?
  toolPayload Json?
  createdAt  DateTime @default(now())
  thread     AiAgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model AiActionLog {
  id           String   @id @default(cuid())
  userId       String
  threadId     String?
  actionName   String
  status       String
  inputPayload Json?
  outputPayload Json?
  errorMessage String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread       AiAgentThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([threadId, createdAt])
}

model AiIncident {
  id              String   @id @default(cuid())
  userId          String?
  createdByUserId String?
  severity        String   @default("MEDIUM")
  status          String   @default("OPEN")
  source          String   @default("BEE_UP")
  title           String
  summary         String
  fingerprint     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User?    @relation("AiIncidentUser", fields: [userId], references: [id], onDelete: SetNull)
  createdBy       User?    @relation("AiIncidentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  events          AiIncidentEvent[]

  @@index([status, severity, createdAt])
  @@index([userId, createdAt])
}

model AiIncidentEvent {
  id         String   @id @default(cuid())
  incidentId String
  type       String
  message    String
  payload    Json?
  createdAt  DateTime @default(now())
  incident   AiIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

model AiUserAlert {
  id        String   @id @default(cuid())
  userId    String
  kind      String   @default("BEE_UP")
  title     String
  message   String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}
