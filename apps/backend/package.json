{
  "name": "@socialup/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/free-port.mjs && tsx watch src/bootstrap.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bootstrap.js",
    "prisma:generate": "node ../../scripts/run-with-root-env.mjs prisma generate",
    "prisma:generate:sqlite": "node ../../scripts/run-with-root-env.mjs prisma generate --schema prisma/schema.sqlite.prisma",
    "prisma:migrate": "node ../../scripts/run-with-root-env.mjs prisma db push",
    "prisma:seed": "node ../../scripts/run-with-root-env.mjs tsx prisma/seed.ts",
    "prisma:migrate:sqlite-to-postgres": "npm run prisma:generate:sqlite && node ../../scripts/run-with-root-env.mjs tsx prisma/migrate-sqlite-to-postgres.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@socialup/shared": "1.0.0",
    "amqplib": "^0.10.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "ioredis": "^5.8.1",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "stripe": "^18.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.5",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
