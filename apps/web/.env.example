# Opcional: sobrescreve a URL base do backend (API).
# Use isso quando abrir o painel por um dominio/tunnel que nao e localhost.
#
# Exemplo (tunnel do backend):
# VITE_API_URL=https://seu-subdominio.trycloudflare.com
#
# Exemplo (backend local):
# VITE_API_URL=http://localhost:4000
VITE_API_URL=

# Janela para reaproveitar o QR no painel (ms). Default: 45000
# Sugestao: 180000 (3 min)
VITE_WHATSAPP_QR_REUSE_WINDOW_MS=180000
