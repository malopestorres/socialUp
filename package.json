{
  "name": "socialup-local",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:backend": "npm run dev -w apps/backend",
    "dev:agent": "npm run dev -w apps/agent",
    "build:agent": "npm run build -w apps/agent",
    "dist:agent": "npm run dist -w apps/agent",
    "dist:agent:mac": "npm run dist:mac -w apps/agent",
    "dist:agent:win": "npm run dist:win -w apps/agent",
    "dist:agent:linux": "npm run dist:linux -w apps/agent",
    "build": "npm run build -ws",
    "prisma:generate": "npm run prisma:generate -w apps/backend",
    "prisma:migrate": "npm run prisma:migrate -w apps/backend",
    "prisma:seed": "npm run prisma:seed -w apps/backend"
  }
}
