{
  "name": "socialup-local",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:backend": "npm run dev -w apps/backend",
    "dev:backend:log": "bash ./scripts/dev-backend-logged.sh",
    "dev:all": "bash ./scripts/dev-all.sh core",
    "dev:all:full": "bash ./scripts/dev-all.sh full",
    "dev:tunnel": "cloudflared tunnel run socialup-backend",
    "dev:tunnel:token": "node ./scripts/run-with-root-env.mjs bash ./scripts/dev-tunnel-token.sh",
    "dev:whatsapp": "bash ./scripts/dev-whatsapp.sh",
    "stop:whatsapp": "bash ./scripts/stop-whatsapp.sh",
    "db:start": "node ./scripts/db-service.mjs start",
    "db:status": "node ./scripts/db-service.mjs status",
    "db:stop": "node ./scripts/db-service.mjs stop",
    "infra:start": "npm run db:start && brew services start redis && brew services start rabbitmq",
    "infra:stop": "brew services stop rabbitmq && brew services stop redis",
    "infra:restart": "npm run infra:stop && npm run infra:start",
    "infra:status": "npm run db:status && brew services list | grep -E 'Name|redis|rabbitmq'",
    "build": "npm run build -ws",
    "prisma:generate": "npm run prisma:generate -w apps/backend",
    "prisma:migrate": "npm run prisma:migrate -w apps/backend",
    "prisma:seed": "npm run prisma:seed -w apps/backend"
  }
}
